{
  "name": "@chot-via/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/database/seed.ts && tsx --env-file=../../.env src/database/seed-demo-content.ts && tsx --env-file=../../.env src/database/seed-home.ts",
    "db:seed:sample": "tsx --env-file=../../.env src/database/seed-sample.ts",
    "db:seed:home": "tsx --env-file=../../.env src/database/seed-home.ts",
    "db:embedded": "tsx scripts/embedded-postgres.ts",
    "db:reset": "tsx --env-file=../../.env scripts/reset-db.ts",
    "db:seed:baseline": "tsx --env-file=../../.env src/database/seed.ts && tsx --env-file=../../.env src/database/seed-home.ts && tsx --env-file=../../.env src/database/seed-baseline.ts",
    "db:reset:baseline": "pnpm db:reset && pnpm db:migrate && pnpm db:seed:baseline"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@chot-via/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@sentry/node": "^11.14.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "postgres": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
