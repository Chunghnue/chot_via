# ===== Backend =====
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://xinvia:xinvia@localhost:5432/xinvia
# Để trống = dùng bộ đếm trong bộ nhớ (dev). Production nên dùng Redis.
REDIS_URL=
JWT_ACCESS_SECRET=dev-access-secret-change-me-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Tên miền chung của cookie phiên (web public + admin ở tên miền con dùng chung đăng nhập). Dev (localhost) để trống.
COOKIE_DOMAIN=
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
# SMS OTP: dev = in OTP ra log, KHÔNG gửi SMS thật. Production: speedsms | esms
SMS_PROVIDER=dev
DEV_FIXED_OTP=123456
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SENDER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
# GHDC (SMS_PROVIDER=ghdc): GHDC_SMS_BASE_URL, GHDC_SMS_EMAIL, GHDC_SMS_PASSWORD, GHDC_SMS_CP_ID, GHDC_SMS_TEMP_ID
# Chống bot (để trống = tắt)
TURNSTILE_SECRET=
# Lưu file: local | s3 (Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# Đăng nhập mạng xã hội (P1) — để trống = nút bị ẩn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SENTRY_DSN=
# Tài khoản quản trị đầu tiên (seed)
SEED_ADMIN_PHONE=0368886999
SEED_ADMIN_NAME=Quản trị Xin Vía

# ===== Web public / admin =====
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Tên miền công khai dùng trong link chia sẻ (mặc định https://xinvia.co)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
