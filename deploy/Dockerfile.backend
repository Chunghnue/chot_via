# syntax=docker/dockerfile:1
FROM node:24-alpine AS build
RUN npm install -g pnpm@12.18.0
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/backend/package.json apps/backend/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @chot-via/backend...
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/backend apps/backend
RUN pnpm --filter @chot-via/backend build \
 && pnpm --filter @chot-via/backend --prod deploy --legacy /out

FROM node:24-alpine AS run
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /repo/apps/backend/dist ./dist
COPY --from=build /repo/apps/backend/drizzle ./drizzle
RUN mkdir -p /data/storage && chown -R node:node /data /app
USER node
EXPOSE 3001
CMD ["node", "dist/main.js"]
