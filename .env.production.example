# Mẫu cấu hình production. Sao chép thành .env.production rồi điền; KHÔNG đưa .env.production vào git.
# Dùng với: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Tạo bí mật: openssl rand -hex 32
#
# Các biến sau do docker-compose.prod.yml tự đặt, KHÔNG khai báo ở đây:
# NODE_ENV, PORT, DATABASE_URL, REDIS_URL, COOKIE_SECURE, STORAGE_LOCAL_DIR, PUBLIC_WEB_URL, PUBLIC_ADMIN_URL, PUBLIC_API_URL.

# ===== Bắt buộc =====
# Tên miền web và admin (bản ghi A/AAAA phải trỏ về máy chủ trước khi chạy).
WEB_DOMAIN=
ADMIN_DOMAIN=
# Mật khẩu Postgres (compose từ chối chạy nếu thiếu).
POSTGRES_PASSWORD=
# Khóa ký phiên, tối thiểu 32 ký tự.
JWT_ACCESS_SECRET=

# Tài khoản quản trị đầu tiên, được tạo ở lần chạy `migrate` đầu tiên.
# BẮT BUỘC điền SỐ ĐIỆN THOẠI THẬT của bạn (OTP sẽ gửi SMS tới số này).
# Trống hoặc sai định dạng thì KHÔNG có admin nào được tạo; mặc định của mã nguồn là số dev 0900000000, không nhận được SMS.
# Chỉ có tác dụng ở lần tạo đầu: đổi sau khi đã chạy thì không đổi admin đã tạo (phải sửa trong database).
SEED_ADMIN_PHONE=
SEED_ADMIN_NAME=Quản trị Xin Vía

# ===== SMS OTP (bắt buộc: production không cho dùng mã OTP dev) =====
# Chọn một: speedsms | esms | ghdc
SMS_PROVIDER=
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SENDER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
# GHDC_SMS_BASE_URL để trống = https://sms.ghdc.vn/api
GHDC_SMS_BASE_URL=
GHDC_SMS_EMAIL=
GHDC_SMS_PASSWORD=
GHDC_SMS_CP_ID=
GHDC_SMS_TEMP_ID=

# ===== Nên điền =====
# Đặt bằng WEB_DOMAIN (admin là tên miền con) để web public và admin dùng chung phiên đăng nhập. Để trống = hai trang không dùng chung phiên.
COOKIE_DOMAIN=

# ===== Tùy chọn (để trống = tắt) =====
# Chống bot Cloudflare Turnstile. Khóa công khai (NEXT_PUBLIC_*) được đưa vào mã lúc build.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# PostHog (máy chủ EU). NEXT_PUBLIC_* được đưa vào mã lúc build: đổi thì phải `up -d --build`.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
# Lưu ảnh: local (mặc định, volume uploads) hoặc s3 (Cloudflare R2).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# Đăng nhập mạng xã hội: để trống thì nút bị ẩn.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
